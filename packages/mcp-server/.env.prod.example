# Copy to .env.prod and select TQX_ENV=prod in the process environment.
TQX_ENV=prod
# Process values override this file; this file overrides .env.local.
# The environment label alone does not change endpoints or enable tools.
# Fill actual deployment overrides below; unknown production URLs are not guessed.
# Omitted values retain the original configuration/default chain.
# MCP_HOST=
# MCP_PORT=
# MCP_RESOURCE=
# MCP_OAUTH_ISSUER=
# MCP_JWKS_URL=
# MCP_API_RESOURCE=
# MCP_TRADING_BASE_URL=
# MCP_ALLOWED_HOSTS=
# MCP_ALLOWED_ORIGINS=
# Existing native TLS pair or TLS ingress settings apply to HTTPS resources.
# MCP_TLS_CERT_FILE=
# MCP_TLS_KEY_FILE=
# MCP_TLS_TERMINATED_BY_PROXY=false
# Tool flags retain existing defaults (false) and any explicit runtime override.
# Never put MCP_EXCHANGE_CLIENT_SECRET or private key contents in a tracked template.
