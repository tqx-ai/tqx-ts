# Copy to .env.test and select TQX_ENV=test in the process environment.
TQX_ENV=test
# Process values override this file; this file overrides .env.local.
# Missing overrides retain .env.local and the existing loopback defaults.
# Set the actual test deployment values; no test hostname is invented here.
# MCP_HOST=127.0.0.1
# MCP_PORT=3002
# MCP_RESOURCE=http://127.0.0.1:3002/mcp
# MCP_OAUTH_ISSUER=http://127.0.0.1:26823
# MCP_JWKS_URL=http://127.0.0.1:26823/.well-known/jwks.json
# MCP_API_RESOURCE=http://127.0.0.1:8100/api
# MCP_TRADING_BASE_URL=http://127.0.0.1:8100
# MCP_ALLOWED_HOSTS=127.0.0.1:3002
# MCP_ALLOWED_ORIGINS=http://127.0.0.1:3002
# Keep credentials and TLS keys in private runtime configuration.
# Existing TLS and enabled-tool exchange-secret checks remain unchanged.
