# Copy to .env.test and select TQX_ENV=test in the process environment.
TQX_ENV=test
# Process values override this file; this file overrides .env.local.
# Missing overrides retain .env.local and the existing loopback defaults.
# Set the actual test deployment values; no test hostname is invented here.
# MCP_HOST=127.0.0.1
# MCP_PORT=3002
# MCP_RESOURCE=http://127.0.0.1:3002/mcp
# MCP_OAUTH_ISSUER=http://127.0.0.1:26823
# MCP_JWKS_URL=http://127.0.0.1:26823/.well-known/jwks.json
# MCP_API_RESOURCE=http://127.0.0.1:8100/api
# MCP_TRADING_BASE_URL=http://127.0.0.1:8100
# MCP_ALLOWED_HOSTS=127.0.0.1:3002
# MCP_ALLOWED_ORIGINS=http://127.0.0.1:3002
# Keep credentials and TLS keys in private runtime configuration.
# Existing TLS and enabled-tool exchange-secret checks remain unchanged.

# Optional planned LAN test deployment (not a running/verified endpoint).
# Only effective TQX_ENV=test enables this exact-origin HTTP exception.
# Canonical RFC1918 IPv4 origins only; no slash, CIDR, wildcard, DNS, or explicit :80.
# TQX_TEST_HTTP_ORIGINS=http://192.168.1.3:3002,http://192.168.1.3:26823,http://192.168.1.3:8100,http://192.168.1.3:3001
# MCP_HOST=0.0.0.0
# MCP_PORT=3002
# MCP_RESOURCE=http://192.168.1.3:3002/mcp
# MCP_OAUTH_ISSUER=http://192.168.1.3:26823
# MCP_JWKS_URL=http://192.168.1.3:26823/.well-known/jwks.json
# MCP_API_RESOURCE=http://192.168.1.3:8100/api
# MCP_TRADING_BASE_URL=http://192.168.1.3:8100
# MCP_ALLOWED_HOSTS=192.168.1.3:3002
# MCP_ALLOWED_ORIGINS=http://192.168.1.3:3001
# MCP_TLS_TERMINATED_BY_PROXY=false
# MCP_TRADING_TOOLS_ENABLED=false
# MCP_TRADING_WRITE_TOOLS_ENABLED=false
# HTTP requires no TLS cert/key; never claim proxy termination to bypass checks.
