{
  "name": "@tqx-ai/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun src/index.ts",
    "start": "node dist/index.mjs",
    "build": "tsdown",
    "typecheck:mcp": "tsc --project tsconfig.json --noEmit && tsc --project integrations/codex/tsconfig.json --noEmit",
    "lint:mcp": "oxfmt --threads=4 --check . && oxlint --deny-warnings .",
    "format:mcp": "oxfmt --threads=4 .",
    "test:mcp": "vitest run --config vitest.config.ts",
    "smoke": "node scripts/smoke.mjs",
    "check": "oxfmt --threads=4 --check . && oxlint --deny-warnings . && tsc --project tsconfig.json --noEmit && tsc --project integrations/codex/tsconfig.json --noEmit && vitest run --config vitest.config.ts && tsdown"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@tqx-ai/sdk": "workspace:*",
    "express": "^5.1.0",
    "jose": "6.2.13",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
