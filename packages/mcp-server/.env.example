# From this directory, copy .env.example to .env and adjust for your deployment.
# MCP server runtime configuration; these values are not embedded by tsdown.
# Optional listener override; Docker sets 0.0.0.0, local startup defaults to 127.0.0.1.
# TQX_MCP_BIND_HOST=127.0.0.1
# Docker defaults to production. For HTTP development, explicitly set NODE_ENV=development.
# NODE_ENV=development
# The canonical resource must match tqx-oauth's MCP resource and the access token audience.
TQX_MCP_RESOURCE_URL=https://www.tqx.trade/mcp
TQX_MCP_OAUTH_ISSUER=https://auth.tqx.ai

# Comma-separated hostnames, without scheme or port. Include your server hostname/IP for HTTP dev.
TQX_MCP_ALLOWED_HOSTS=www.tqx.trade,127.0.0.1,localhost,[::1]

# Exact browser origins (scheme + host + port), comma-separated; empty allows native clients only.
# For local Inspector, use http://localhost:6274 outside NODE_ENV=production.
TQX_MCP_ALLOWED_ORIGINS=https://www.tqx.trade,https://www.tqx.ai,http://localhost:6274

# Trading integration: all four values are required to enable tools.
# Comment out all four variables to disable trading tools and use the existing authentication-only server.
# The gateway origin and the AS-registered downstream audience are different settings.
TQX_MCP_TRADING_BASE_URL=https://www.tqx.trade
TQX_MCP_TRADING_RESOURCE=https://www.tqx.trade/openapi
TQX_MCP_EXCHANGE_CLIENT_ID=tqx_mcp_server
# The exact same secret must be injected into tqx-oauth as TQX_MCP_EXCHANGE_CLIENT_SECRET.
# Never commit or log this value.
TQX_MCP_EXCHANGE_CLIENT_SECRET=<inject-deployment-secret>
