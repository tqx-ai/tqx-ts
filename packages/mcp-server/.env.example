# All settings are read at runtime. Copy to .env.local for local development.
# Defaults below bind only loopback; do not put tokens, private keys, or passwords here.
MCP_HOST=127.0.0.1
MCP_PORT=3002
MCP_RESOURCE=http://127.0.0.1:3002/mcp
MCP_OAUTH_ISSUER=http://127.0.0.1:26823
MCP_JWKS_URL=http://127.0.0.1:26823/.well-known/jwks.json

# Comma-separated EXACT authorities (including non-default ports), no wildcards.
MCP_ALLOWED_HOSTS=127.0.0.1:3002
# Comma-separated EXACT origins, no trailing slash. Native clients may omit Origin.
MCP_ALLOWED_ORIGINS=http://127.0.0.1:3002

# Non-loopback public resources must use HTTPS. Choose native TLS OR explicit TLS ingress.
# Native TLS: PEM files mounted at runtime; set both paths.
# MCP_TLS_CERT_FILE=/run/secrets/mcp/tls.crt
# MCP_TLS_KEY_FILE=/run/secrets/mcp/tls.key
# TLS ingress: internal listener is HTTP; network policy must restrict it to the TLS proxy.
MCP_TLS_TERMINATED_BY_PROXY=false

MCP_JWKS_TIMEOUT_MS=5000
MCP_JWKS_CACHE_MAX_AGE_MS=600000
MCP_JWKS_COOLDOWN_MS=30000
MCP_SHUTDOWN_TIMEOUT_MS=5000
MCP_REQUEST_TIMEOUT_MS=30000
MCP_HEADERS_TIMEOUT_MS=10000
MCP_KEEP_ALIVE_TIMEOUT_MS=5000

# Optional read-only integration. OFF preserves the empty tool list and offline JWT skeleton.
# ON requires agent_id/grant_id and exchange on every protected HTTP request, even initialize/list.
MCP_TRADING_TOOLS_ENABLED=false
MCP_API_RESOURCE=http://127.0.0.1:8100/api
MCP_TRADING_BASE_URL=http://127.0.0.1:8100
# Private developer/runtime secret for pre-provisioned tqx_mcp_server; never distribute in binaries.
# Must match OAuth OAUTH_MCP_EXCHANGE_CLIENT_SECRET; leave empty while the feature is off.
MCP_EXCHANGE_CLIENT_SECRET=
MCP_EXCHANGE_TIMEOUT_MS=5000
MCP_TRADING_TIMEOUT_MS=10000
