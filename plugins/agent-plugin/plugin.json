{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "tqx-agent-plugin",
  "version": "0.7.0",
  "description": "Let TQX help you invest and trade",
  "author": {
    "name": "TQX Team",
    "email": "joshua@tqx.ai",
    "url": "https://www.tqx.ai"
  },
  "homepage": "https://www.tqx.ai",
  "repository": "https://github.com/tqx-ai/tqx-ts",
  "license": "GPL-3.0-only",
  "keywords": [
    "investment",
    "trading",
    "asset-discovery",
    "finance",
    "market-research",
    "tqx",
    "agent-plugin",
    "AI investing",
    "AI trading",
    "agent investing",
    "agent trading",
    "Hong Kong stocks",
    "US stocks"
  ],
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./skills/tqx-setup/SKILL.md",
      "interface": {
        "displayName": "TQX",
        "shortDescription": "Invest and trade with TQX",
        "longDescription": "Connect your TQX account to view balances, positions, orders, trades, and cash flows, and place, modify, or cancel orders when requested. Access Hong Kong and US market data through the included Python skill. Trading requires OAuth authorization; market data requires a TQX API key and a compatible local Python environment.",
        "developerName": "TQX Team",
        "category": "Productivity",
        "capabilities": ["Market data", "Portfolio monitoring", "Order management"],
        "websiteURL": "https://www.tqx.ai",
        "supportURL": "https://docs.tqx.ai/more/contact-us",
        "privacyPolicyURL": "https://www.tqx.ai/auth/privacy-policy",
        "termsOfServiceURL": "https://www.tqx.ai/auth/user-agreement",
        "defaultPrompt": [
          "Show my TQX account balance and positions.",
          "List my active orders and recent trades.",
          "Help me set up Hong Kong and US market data."
        ],
        "brandColor": "#A3A325",
        "brandColorDark": "#FFFF3A",
        "composerIcon": "./com.openai/assets/icon.svg",
        "composerIconDark": "./com.openai/assets/icon.svg",
        "logo": "./com.openai/assets/logo.png",
        "logoDark": "./com.openai/assets/logo.png"
      }
    },
    "ai.nanoco.nanoclaw": {
      "agentName": "TQX"
    },
    "ai.openclaw": {
      "activation": {
        "onStartup": false,
        "onCapabilities": ["tool"]
      }
    }
  }
}
