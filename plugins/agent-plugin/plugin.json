{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "tqx-agent-plugin",
  "version": "0.9.0-beta.2",
  "description": "Let TQX help you invest and trade",
  "author": {
    "name": "TQX Team",
    "email": "joshua@tqx.ai",
    "url": "https://www.tqx.ai"
  },
  "homepage": "https://www.tqx.ai",
  "repository": "https://github.com/tqx-ai/tqx-ts",
  "license": "GPL-3.0-only",
  "keywords": [
    "investment",
    "trading",
    "asset-discovery",
    "finance",
    "market-research",
    "tqx",
    "agent-plugin",
    "AI investing",
    "AI trading",
    "agent investing",
    "agent trading",
    "Hong Kong stocks",
    "US stocks"
  ],
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./skills/tqx-setup/SKILL.md",
      "interface": {
        "displayName": "TQX",
        "shortDescription": "Invest and trade with TQX",
        "longDescription": "Connect your TQX account to view balances, positions, orders, trades, and cash flows, and execute trading instructions. Research Hong Kong and US factors and strategies through Qube analyses, backtests, versions and parameter tuning. Trading and research use client-managed OAuth with separate scopes; research does not require a trading Agent binding. Local market data uses the included Python skill and requires a TQX API key and compatible Python environment.",
        "developerName": "TQX Team",
        "category": "Productivity",
        "capabilities": [
          "Market data",
          "Portfolio monitoring",
          "Order management",
          "Factor and strategy research"
        ],
        "websiteURL": "https://www.tqx.ai",
        "supportURL": "https://docs.tqx.ai/more/contact-us",
        "privacyPolicyURL": "https://www.tqx.ai/auth/privacy-policy",
        "termsOfServiceURL": "https://www.tqx.ai/auth/user-agreement",
        "defaultPrompt": [
          "Show my TQX account balance and positions.",
          "List my active orders and recent trades.",
          "Help me set up Hong Kong and US market data.",
          "Create and backtest a US stock momentum strategy."
        ],
        "brandColor": "#A3A325",
        "brandColorDark": "#FFFF3A",
        "composerIcon": "./com.openai/assets/icon.svg",
        "composerIconDark": "./com.openai/assets/icon.svg",
        "logo": "./com.openai/assets/logo.png",
        "logoDark": "./com.openai/assets/logo.png"
      }
    },
    "ai.nanoco.nanoclaw": {
      "agentName": "TQX"
    },
    "ai.openclaw": {
      "activation": {
        "onStartup": false,
        "onCapabilities": ["tool"]
      }
    }
  }
}
