# Copy this file to .env, .env.dev, or .env.prod as needed.
# These public values are read during bun build/dev and embedded in the CLI and SDK.
# Node.js does not load these files when the built CLI runs.

# Build-time default for the research/non-trading HTTP gateway
TQX_BUILD_BASE_URL=https://www.tqx.trade/pandaApi

# Build-time default for trading, authentication, and health
TQX_BUILD_TRADING_BASE_URL=https://www.tqx.trade

# Build-time URL shown in CLI login guidance
TQX_BUILD_GET_API_KEY_URL=https://www.tqx.ai/user-center?tab=dev-settings

# Runtime override for every gateway. Set it in the process environment when running the CLI.
# TQX_BASE_URL=https://api.example.test

# Optional runtime mirror for CLI release metadata and assets.
# TQX_UPDATE_RELEASES_URL=https://api.github.com/repos/tqx-ai/tqx-ts/releases
# Set to 0 to disable the background once-per-day update check.
# TQX_UPDATE_CHECK=0
